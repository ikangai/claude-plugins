{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.groupchat/hooks/session_start.py\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.groupchat/hooks/user_prompt_submit.py\"", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.groupchat/hooks/stop.py\"", "timeout": 600, "statusMessage": "⏳ parked at the agora team barrier — not stopped: wakes on a teammate's @mention, exits when the whole team is done" } ] }
    ]
  }
}
